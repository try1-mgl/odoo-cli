# Template Environment Variables odoo-cli
# Salin berkas ini ke `.env` dan sesuaikan nilainya.
# PERINGATAN: Jangan pernah meng-commit berkas `.env` ke Git!

# Konfigurasi Koneksi Odoo
ODOO_URL=http://localhost:8069
ODOO_DB=learn
ODOO_USERNAME=admin@yourcompany.com
ODOO_PASSWORD=your_api_key_or_password

# Pengaturan Eksekusi
ODOO_REQUIRE_APPROVAL=false
